ErrorDocument 404 /404.html

# Une seule adresse : https://axionstudio.fr (sans www), en une seule redirection
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.axionstudio\.fr$ [NC]
  RewriteRule ^(.*)$ https://axionstudio.fr/$1 [R=301,L]

  # Agents d'IA : l'accueil en Markdown quand ils le demandent (Accept: text/markdown)
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^$ /index.md [L]
</IfModule>
AddType text/markdown .md

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Signale aux agents d'IA le résumé du site (llms.txt) et que l'accueil change selon le format demandé
  Header always set Link '</llms.txt>; rel="alternate"; type="text/plain"; title="llms.txt"'
  Header always append Vary "Accept"

  # Fichiers versionnés (leur nom change à chaque publication) : un an en cache
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages : toujours revalidées, pour que les mises à jour soient visibles tout de suite
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Le fichier de configuration (clé d'API) et les fonctions PHP communes ne doivent jamais être appelés depuis le web
<FilesMatch "^(axion-config|_common)\.php$">
  Require all denied
</FilesMatch>
