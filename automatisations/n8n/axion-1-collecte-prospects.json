        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ textQuery: $json.nom + ' ' + $json.ville, languageCode: 'fr', regionCode: 'FR', pageSize: 1 }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 200
            }
          },
          "timeout": 15000
        }
