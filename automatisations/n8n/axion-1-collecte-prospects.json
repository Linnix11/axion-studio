        "jsCode": "// Une ligne par page de résultats de l'annuaire (25 entreprises par page)\nconst { pages } = $('Critères de recherche').first().json\nreturn Array.from({ length: pages }, (_, i) => ({ json: { page: i + 1 } }))"
